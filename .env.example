# Copia este archivo a .env (ignorado por git). Solo valores de desarrollo local.
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# Puertos del host para docker compose (5432 suele estar ocupado por un Postgres local).
POSTGRES_PORT=5433
REDIS_PORT=6379

# Deben coincidir con los puertos de arriba.
DATABASE_URL=postgresql+asyncpg://smartwatch:smartwatch@localhost:5433/smartwatch
REDIS_URL=redis://localhost:6379/0

# Secreto de firma de JWT. En local cualquier valor largo; en producción, uno aleatorio de 64+ caracteres.
JWT_SECRET=dev-solo-local-cambia-esto-en-produccion-0123456789abcdef

# Origen del panel web (CORS con credenciales).
WEB_ORIGIN=http://localhost:5173
