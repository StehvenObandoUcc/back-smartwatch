# Copia este archivo a .env (ignorado por git). Solo valores de desarrollo local.
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# Puertos del host para docker compose (5432 suele estar ocupado por un Postgres local).
POSTGRES_PORT=5433
REDIS_PORT=6379

# Deben coincidir con los puertos de arriba.
DATABASE_URL=postgresql+asyncpg://smartwatch:smartwatch@localhost:5433/smartwatch
REDIS_URL=redis://localhost:6379/0

# Secreto de firma de JWT. En local cualquier valor largo; en producción, uno aleatorio de 64+ caracteres.
JWT_SECRET=dev-solo-local-cambia-esto-en-produccion-0123456789abcdef

# Origen del panel web (CORS con credenciales).
WEB_ORIGIN=http://localhost:5173

# Correo. `console` escribe los correos (con sus enlaces) en el log del worker: solo local y test.
# En staging/producción: EMAIL_PROVIDER=resend con la clave y un remitente de dominio verificado
# (SPF, DKIM y DMARC). La clave solo por variable de entorno, nunca en el repositorio.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=Recordatorios <avisos@tu-dominio.com>
# Tras entregar, el outbox borra los enlaces del mensaje. En local déjalo en false para poder
# leerlos en la tabla notifications_outbox (lo usan los scripts de verificación).
OUTBOX_SCRUB_PAYLOAD=false

# Telegram. Usuario del bot (sin @) para armar el enlace https://t.me/<Bot>?start=<token>.
# TELEGRAM_BOT_TOKEN lo da @BotFather: solo por variable de entorno, nunca en el repositorio.
# El secreto del webhook (16-256 caracteres A-Za-z0-9_-) lo eliges tú y se envía a Telegram con
# setWebhook; sin él, el webhook rechaza todo. Los valores de abajo son solo de desarrollo local.
TELEGRAM_BOT_USERNAME=MiBotLocal
TELEGRAM_WEBHOOK_SECRET=secreto-local-solo-desarrollo-0123456789
# TELEGRAM_BOT_TOKEN=

# Chat con IA. `fake` responde sin red ni clave (solo local y test). En staging/producción:
# CHAT_PROVIDER=deepseek con DEEPSEEK_API_KEY (solo por variable de entorno, nunca en el repo).
CHAT_PROVIDER=fake
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
